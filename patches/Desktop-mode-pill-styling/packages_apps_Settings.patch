+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Controls the desktop mode app handle style (Settings.Global desktop_mode_pill_style). */
+public class DesktopPillPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String SETTING_DESKTOP_PILL = "desktop_mode_pill_style";
+    private static final int DEFAULT_STYLE = 0; // must match WM Shell default (hidden)
+
+    public DesktopPillPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        final int value = Settings.Global.getInt(mContext.getContentResolver(),
+                SETTING_DESKTOP_PILL, DEFAULT_STYLE);
+        // Summary "%s" is formatted with the selected entry by ListPreference itself.
+        ((ListPreference) preference).setValue(String.valueOf(value));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final int value;
+        try {
+            value = Integer.parseInt((String) newValue);
+        } catch (NumberFormatException e) {
+            return false;
+        }
+        return Settings.Global.putInt(mContext.getContentResolver(), SETTING_DESKTOP_PILL, value);
+    }
+}
