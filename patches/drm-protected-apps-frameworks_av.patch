 status_t MediaCodecBuffer::setRange(size_t offset, size_t size) {
-    return mBuffer->setRangeWithStatus(offset, size);
+    // Secure (DRM-protected) buffers have no CPU-mapped data, so
+    // ABuffer::setRangeWithStatus() would reject them with NO_MEMORY.
+    // Only validate the range against the capacity here.
+    const size_t cap = mBuffer->capacity();
+    if (offset > cap || size > cap - offset) {
+        return BAD_VALUE;
+    }
+    mBuffer->setRange(offset, size);
+    return OK;
 }
 
