    <string name="stylus_refresh_rate_summary">Select display refresh rate for stylus mode</string>
    <string name="stylus_more_info">Stylus Mode enables pen-compatible refresh rates when a supported stylus is connected. The display switches to 60 Hz or 120 Hz only while the pen is connected.</string>

    <!-- Refresh Rate Options -->
    <string name="refresh_rate_dynamic">Dynamic (60/120Hz)</string>
